<Window x:Class="subphimv1.ShortcutsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:subphimv1"
        mc:Ignorable="d"
        Title="Danh sách Phím tắt" Height="460" Width="405"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Style="{StaticResource BorderlessToolWindowStyle}"
        MouseDown="Window_MouseDown">
    <Grid Margin="15">
        <Grid.Resources>
            <Style TargetType="Border" x:Key="HeaderBorderStyle">
                <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="Margin" Value="0,10,0,5"/>
                <Setter Property="Padding" Value="0,2"/>
            </Style>
            <Style TargetType="TextBlock" x:Key="HeaderTextStyle">
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            </Style>

            <Style TargetType="TextBlock" x:Key="KeyStyle">
                <Setter Property="FontFamily" Value="Consolas"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Background" Value="{StaticResource LighterPanelBackgroundColor}"/>
                <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
                <Setter Property="Padding" Value="4,2"/>
                <Setter Property="Margin" Value="0,0,10,0"/>
            </Style>
            <Style TargetType="TextBlock" x:Key="DescriptionStyle">
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </Grid.Resources>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Tiêu đề tùy chỉnh -->
                <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" 
                           FontSize="16" FontWeight="SemiBold" 
                           Foreground="{StaticResource TextColor}"/>

                <Border Style="{StaticResource HeaderBorderStyle}">
                    <TextBlock Style="{StaticResource HeaderTextStyle}" Text="Chức năng chung"/>
                </Border>

                <Grid Margin="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource KeyStyle}" Text="Ctrl + O"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource DescriptionStyle}" Text="Mở file Video"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource KeyStyle}" Text="Ctrl + S"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource DescriptionStyle}" Text="Mở file Phụ đề (SRT/VTT)"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource KeyStyle}" Text="Ctrl + A"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource DescriptionStyle}" Text="Xuất Video có phụ đề"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource KeyStyle}" Text="Ctrl + I"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource DescriptionStyle}" Text="Import phụ đề vào Video"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource KeyStyle}" Text="Ctrl + C"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource DescriptionStyle}" Text="Mở cửa sổ Cài đặt"/>

                    <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource KeyStyle}" Text="Ctrl + Z"/>
                    <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource DescriptionStyle}" Text="Hoàn tác (Undo)"/>

                    <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource KeyStyle}" Text="Ctrl + Y"/>
                    <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource DescriptionStyle}" Text="Làm lại (Redo)"/>
                </Grid>

                <Border Style="{StaticResource HeaderBorderStyle}">
                    <TextBlock Style="{StaticResource HeaderTextStyle}" Text="Điều khiển Trình phát Video"/>
                </Border>

                <Grid Margin="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource KeyStyle}" Text="Space"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource DescriptionStyle}" Text="Phát / Tạm dừng"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource KeyStyle}" Text="→ / ←"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource DescriptionStyle}" Text="Tới / Lùi 1 frame"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource KeyStyle}" Text="Ctrl + → / ←"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource DescriptionStyle}" Text="Tới / Lùi 1 giây"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource KeyStyle}" Text="S / E"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource DescriptionStyle}" Text="Đặt điểm Bắt đầu / Kết thúc cho dòng SRT mới"/>

                    <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource KeyStyle}" Text="F1"/>
                    <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource DescriptionStyle}" Text="Kích hoạt chế độ OCR bằng chuột"/>

                    <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource KeyStyle}" Text="F2"/>
                    <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource DescriptionStyle}" Text="Kích hoạt chế độ OCR + Dịch bằng chuột"/>

                    <TextBlock Grid.Row="7" Grid.Column="0" Style="{StaticResource KeyStyle}" Text="ESC"/>
                    <TextBlock Grid.Row="7" Grid.Column="1" Style="{StaticResource DescriptionStyle}" Text="Hủy chế độ chọn vùng OCR/Dịch"/>

                </Grid>

                <Button Content="Đóng" Width="80" HorizontalAlignment="Right" Margin="0,20,0,0" IsDefault="True" IsCancel="True"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>