                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"  FontFamily="Segoe MDL2 Assets"  FontSize="18"  VerticalAlignment="Center"/>
