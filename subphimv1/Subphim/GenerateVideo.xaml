<Window x:Class="subphimv1.GenerateVideoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Height="500" Width="700"
        WindowStartupLocation="CenterOwner" MinHeight="480" MinWidth="700"
        ShowInTaskbar="False" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        MouseDown="Window_MouseDown">

    <Border BorderBrush="{StaticResource CapCut.AccentColorBlue}" BorderThickness="1" CornerRadius="8" Background="{StaticResource CapCut.PanelBackground}">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="TitleTextBlock" Grid.Row="0" Text="Cài đặt Xuất Video" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,20" Foreground="{StaticResource CapCut.TextColor}"/>

            <DockPanel x:Name="SettingsGrid" Grid.Row="1">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Label Grid.Row="0" Grid.Column="0" Content="Tên file" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="FileNameTextBox" Margin="0,5"/>

                        <Label Grid.Row="1" Grid.Column="0" Content="Xuất sang" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="OutputPathTextBox" IsReadOnly="True" Margin="0,5"/>
                        <Button Grid.Row="1" Grid.Column="2" x:Name="BrowseOutputPathButton" Content="..." Width="30" Margin="5,5,0,5" Click="BrowseOutputPathButton_Click"/>
                    </Grid>
                </StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="280"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*" MinWidth="280"/>
                    </Grid.ColumnDefinitions>
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
                        <StackPanel>
                            <GroupBox Header="Cài đặt Video" Foreground="{StaticResource CapCut.TextSecondaryColor}" Padding="8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Label Grid.Row="0" Grid.Column="0" Content="Tăng tốc GPU" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Row="0" Grid.Column="1" x:Name="GpuComboBox" Margin="0,5" SelectionChanged="GpuComboBox_SelectionChanged"/>

                                    <Label Grid.Row="1" Grid.Column="0" Content="Độ phân giải" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Row="1" Grid.Column="1" x:Name="ResolutionComboBox" Margin="0,5"/>

                                    <Label Grid.Row="2" Grid.Column="0" Content="Bộ mã hóa (Codec)" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Row="2" Grid.Column="1" x:Name="VideoCodecComboBox" Margin="0,5" SelectionChanged="VideoCodecComboBox_SelectionChanged"/>

                                    <Label Grid.Row="3" Grid.Column="0" Content="Preset" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Row="3" Grid.Column="1" x:Name="PresetComboBox" Margin="0,5"/>

                                    <Label Grid.Row="4" Grid.Column="0" x:Name="CrfLabel" Content="Chất lượng (CRF)" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,5">
                                        <Slider x:Name="CrfSlider" Width="120" Minimum="0" Maximum="51" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="CrfSlider_ValueChanged"/>
                                        <TextBox x:Name="CrfValueTextBox" Width="40" Margin="10,0,0,0" Text="{Binding Value, ElementName=CrfSlider, StringFormat={}{0:F0}}" IsReadOnly="True" TextAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Grid.Row="4" Grid.Column="1" x:Name="CrfHintTextBlock" Text="(Càng nhỏ càng tốt)" VerticalAlignment="Center" Margin="175,0,0,0" FontStyle="Italic" Foreground="{StaticResource CapCut.TextSecondaryColor}" FontSize="11" HorizontalAlignment="Left"/>


                                    <Label Grid.Row="5" Grid.Column="0" x:Name="TuneLabel" Content="Tối ưu hóa (Tune)" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Row="5" Grid.Column="1" x:Name="TuneComboBox" Margin="0,5"/>
                                </Grid>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- MỚI: Thanh chia cột -->
                    <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent"/>

                    <!-- === CỘT BÊN PHẢI: HIỆU NĂNG, ÂM THANH, NÂNG CAO === -->
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="10,0,0,0">
                        <StackPanel>
                            <!-- MỚI: Đưa cài đặt Hiệu năng lên đầu -->
                            <GroupBox Header="Cài đặt Hiệu năng ( 0 để tận dụng tối đa CPU)" Foreground="{StaticResource CapCut.TextSecondaryColor}" Padding="8" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0" x:Name="EnableThreadLimitCheckBox" Content="Giới hạn CPU" VerticalAlignment="Center" Checked="EnableThreadLimitCheckBox_Changed" Unchecked="EnableThreadLimitCheckBox_Changed"/>
                                    <StackPanel Grid.Column="1" x:Name="ThreadLimitPanel" Orientation="Horizontal" Margin="0,5">
                                        <Slider x:Name="ThreadSlider" Width="120" Minimum="1" IsSnapToTickEnabled="True" TickFrequency="1"/>
                                        <TextBox x:Name="ThreadValueTextBox" Width="40" Margin="10,0,0,0" Text="{Binding Value, ElementName=ThreadSlider, StringFormat={}{0:F0}}" TextAlignment="Center"/>
                                        <TextBlock Text="luồng" VerticalAlignment="Center" Margin="10,0" FontStyle="Italic" Foreground="{StaticResource CapCut.TextSecondaryColor}" FontSize="11"/>
                                    </StackPanel>
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="Cài đặt Âm thanh" Foreground="{StaticResource CapCut.TextSecondaryColor}" Margin="0,0,0,10" Padding="8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Row="0" Grid.Column="0" Content="Bộ mã hóa (Codec)" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Row="0" Grid.Column="1" x:Name="AudioCodecComboBox" Margin="0,5" SelectionChanged="AudioCodecComboBox_SelectionChanged"/>
                                    <Label Grid.Row="1" Grid.Column="0" Content="Bitrate" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Row="1" Grid.Column="1" x:Name="AudioBitrateComboBox" Margin="0,5"/>
                                    <CheckBox Grid.Row="2" Grid.Column="1" x:Name="StereoCheckBox" Content="Giữ/Chuyển thành Stereo" IsChecked="True" Margin="0,5" VerticalAlignment="Center"/>
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="Nâng cao" Foreground="{StaticResource CapCut.TextSecondaryColor}" Margin="0,0,0,10" Padding="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Row="0" Grid.Column="0" Content="Định dạng Pixel" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Row="0" Grid.Column="1" x:Name="PixelFormatComboBox" Margin="0,5"/>
                                </Grid>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </DockPanel>
            <Grid x:Name="ProgressGrid" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="{StaticResource CapCut.LighterPanelBackground}" CornerRadius="6" Padding="15" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="Đang xuất video..." FontSize="16" FontWeight="SemiBold" Margin="0,0,0,15" TextAlignment="Center"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Tên file:" FontWeight="SemiBold" Margin="0,3"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="ProgressFileNameTextBlock" Text="video_name.mp4" Margin="5,3" Foreground="{StaticResource CapCut.TextSecondaryColor}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Thời lượng:" FontWeight="SemiBold" Margin="0,3"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="ProgressDurationTextBlock" Text="00:01:30" Margin="5,3" Foreground="{StaticResource CapCut.TextSecondaryColor}"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Độ phân giải:" FontWeight="SemiBold" Margin="0,3"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="ProgressResolutionTextBlock" Text="1920x1080" Margin="5,3" Foreground="{StaticResource CapCut.TextSecondaryColor}"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Codec Video:" FontWeight="SemiBold" Margin="0,3"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="ProgressVideoCodecTextBlock" Text="H.264" Margin="5,3" Foreground="{StaticResource CapCut.TextSecondaryColor}"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Codec Audio:" FontWeight="SemiBold" Margin="0,3"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="ProgressAudioCodecTextBlock" Text="AAC" Margin="5,3" Foreground="{StaticResource CapCut.TextSecondaryColor}"/>
                        </Grid>
                    </StackPanel>
                </Border>
                <StackPanel Grid.Row="1" Margin="0,20,0,0">
                    <ProgressBar x:Name="MainProgressBar" Minimum="0" Maximum="100"/>
                    <TextBlock x:Name="StatusTextBlock" Text="Đang chuẩn bị..." HorizontalAlignment="Center" FontSize="12" Margin="0,5,0,0" Foreground="{StaticResource CapCut.TextSecondaryColor}"/>
                    <TextBlock x:Name="PercentageTextBlock" Text="0%" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="16" Margin="0,2,0,0" Foreground="{StaticResource CapCut.TextColor}"/>
                </StackPanel>
            </Grid>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                <Button x:Name="GenerateButton" Content="Xuất" Width="120" Height="30" IsDefault="True" Click="GenerateButton_Click" Style="{StaticResource ExportButtonStyle}"/>
                <Button x:Name="CancelButton" Content="Hủy" Width="80" Height="30" Margin="10,0,0,0" IsCancel="True" Click="CancelButton_Click"/>
                <Button x:Name="CloseButton" Content="Đóng" Width="80" Height="30" Margin="10,0,0,0" Click="CloseButton_Click" Visibility="Collapsed"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>