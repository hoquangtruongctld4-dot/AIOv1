<Window x:Class="subphimv1.CustomMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:subphimv1"
        mc:Ignorable="d"
        Style="{StaticResource BorderlessToolWindowStyle}"
        WindowStartupLocation="CenterOwner"
        SizeToContent="WidthAndHeight"
        MinWidth="350"
        MaxWidth="500"
        Title="Thông báo">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Hàng 0: Title -->
        <TextBlock x:Name="TitleText"
                   Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                   FontSize="16" FontWeight="SemiBold"
                   Foreground="{StaticResource TextColor}"
                   Margin="0,0,0,15"/>

        <!-- Hàng 1: Icon and Message -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="IconText"
                       Grid.Column="0"
                       FontFamily="Segoe MDL2 Assets"
                       FontSize="36"
                       VerticalAlignment="Top"
                       Margin="0,0,15,0"
                       Foreground="{StaticResource AccentColor}"/>

            <TextBlock x:Name="MessageText"
                       Grid.Column="1"
                       Text="Đây là nội dung của thông báo."
                       TextWrapping="Wrap"
                       Foreground="{StaticResource TextSecondaryColor}"
                       VerticalAlignment="Center"/>
        </Grid>

        <!-- Hàng 2: Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="OkButton" Content="OK" Width="80" Margin="5,0" Click="Button_Click" IsDefault="True"/>
            <Button x:Name="YesButton" Content="Yes" Width="80" Margin="5,0" Click="Button_Click"/>
            <Button x:Name="NoButton" Content="No" Width="80" Margin="5,0" Click="Button_Click" IsCancel="True"/>
            <Button x:Name="CancelButton" Content="Cancel" Width="80" Margin="5,0" Click="Button_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>