<Window x:Class="subphimv1.ApiKeysDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:subphimv1"
        mc:Ignorable="d"
        Title="Quản lý Gemini API Keys" Height="275" Width="415"
        WindowStartupLocation="CenterOwner"
    WindowStyle="None" 
        AllowsTransparency="True"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Background="Transparent" 
        Foreground="{StaticResource TextColor}"
        FontFamily="Segoe UI">

    <Border BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Background="{StaticResource WindowBackgroundColor}" RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <TransformGroup>
                <ScaleTransform/>
                <SkewTransform/>
                <RotateTransform Angle="-0.023"/>
                <TranslateTransform/>
            </TransformGroup>
        </Border.RenderTransform>
        <Grid Margin="0,0,14,4">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- === THANH TIÊU ĐỀ TÙY CHỈNH (GIỐNG CỬA SỔ CHÍNH) === -->
            <Grid Grid.Row="0" x:Name="TitleBar" MouseDown="TitleBar_MouseDown" Background="Transparent" Margin="0,0,0,11">
                <!-- Tiêu đề bên trái -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0"/>

                <!-- Nút đóng bên phải -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryColor}" Width="343" Height="22"><Run Text="Mỗi API key 1 dòng"/><LineBreak/><Run/><LineBreak/><Run/></TextBlock>
                    <Button Style="{StaticResource WindowCloseButtonStyle}" Content="✕" Click="CancelButton_Click"/>
                </StackPanel>
            </Grid>

            <!-- === NỘI DUNG CHÍNH (KHÔNG THAY ĐỔI LOGIC) === -->
            <Grid Grid.Row="1" Margin="20,0,20,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>



                <Border Grid.Row="1" BorderThickness="1" BorderBrush="{StaticResource BorderColor}" CornerRadius="4">
                    <TextBox x:Name="KeysTextBox"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top"
                             FontFamily="Consolas"
                             Padding="8"
                             Background="Transparent"
                             BorderThickness="0" Margin="0,0,1,-4"/>
                </Border>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                    <!-- Các nút này sẽ tự động nhận style từ App.xaml -->
                    <Button x:Name="SaveButton" Content="Lưu " MinWidth="80" IsDefault="True" Click="SaveButton_Click" Width="71"/>
                    <Button x:Name="CancelButton" Content="Hủy" MinWidth="80" IsCancel="True" Click="CancelButton_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>