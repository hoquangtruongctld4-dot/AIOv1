<Window x:Class="subphimv1.TtsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:subphimv1"
        mc:Ignorable="d"
        Title="AIO Text-to-Speech" Height="750" Width="1100"
        MinHeight="720" MinWidth="900"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent"
        Foreground="{StaticResource TextColor}"
        FontFamily="Segoe UI Variable Display" Loaded="Window_Loaded">

    <!-- TOÀN BỘ PHẦN RESOURCES GIỮ NGUYÊN NHƯ FILE CŨ CỦA BẠN -->
    <Window.Resources>
        <Color x:Key="CyberAccentColor">#FF00FFFF</Color>
        <SolidColorBrush x:Key="CyberAccentBrush" Color="{StaticResource CyberAccentColor}"/>
        <SolidColorBrush x:Key="CyberBackgroundBrush" Color="#1A00FFFF"/>
        <SolidColorBrush x:Key="CyberHoverBrush" Color="#3300FFFF"/>
        <Color x:Key="PrimaryAccentColor">#FFC39BD3</Color>
        <Color x:Key="SecondaryAccentColor">#FF5DADE2</Color>
        <Color x:Key="AccentHoverColor">#FFD2B4DE</Color>
        <Color x:Key="AccentPressedColor">#FFB284C8</Color>
        <Color x:Key="SuccessColor">#FF32CD32</Color>
        <Color x:Key="ErrorColor">#FFFF4500</Color>
        <Color x:Key="WindowBackgroundColorValue">#FF1A1A2E</Color>
        <Color x:Key="GlassColor">#4CFFFFFF</Color>
        <Color x:Key="BorderColorValue">#33FFFFFF</Color>
        <Color x:Key="TextColorValue">#FFFFFFFF</Color>
        <Color x:Key="TextSecondaryColorValue">#FFA9A9A9</Color>
        <Color x:Key="ShadowColorValue">#FF000000</Color>
        <FontFamily x:Key="CyberpunkFont">/subphimv1;component/Fonts/RussoOne-Regular.ttf#Russo One</FontFamily>
        <SolidColorBrush x:Key="TextColor" Color="{StaticResource TextColorValue}"/>
        <SolidColorBrush x:Key="TextSecondaryColor" Color="{StaticResource TextSecondaryColorValue}"/>
        <SolidColorBrush x:Key="BorderColor" Color="{StaticResource BorderColorValue}"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
        <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>
        <SolidColorBrush x:Key="PrimaryAccentBrush" Color="{StaticResource PrimaryAccentColor}"/>
        <SolidColorBrush x:Key="SecondaryAccentBrush" Color="{StaticResource SecondaryAccentColor}"/>
        <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}"/>
        <Color x:Key="ActionButtonColor">#FF5D3FD3</Color>
        <!-- Màu tím đậm hơn -->
        <Color x:Key="ActionButtonHoverColor">#FF7B68EE</Color>
        <!-- Sáng hơn một chút khi hover -->
        <Color x:Key="ActionButtonPressedColor">#FF483D8B</Color>
        <!-- Tối hơn khi nhấn -->

        <!-- BRUSH MỚI TỪ MÀU SẮC TRÊN -->
        <SolidColorBrush x:Key="ActionButtonBrush" Color="{StaticResource ActionButtonColor}"/>
        <SolidColorBrush x:Key="ActionButtonHoverBrush" Color="{StaticResource ActionButtonHoverColor}"/>
        <SolidColorBrush x:Key="ActionButtonPressedBrush" Color="{StaticResource ActionButtonPressedColor}"/>

        <LinearGradientBrush x:Key="CardBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#A02C2A4E" Offset="0.0" />
            <GradientStop Color="#A02E3B52" Offset="1.0" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="{StaticResource PrimaryAccentColor}" Offset="0.0" />
            <GradientStop Color="{StaticResource SecondaryAccentColor}" Offset="1.0" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="AccentHoverBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="{StaticResource AccentHoverColor}" Offset="0.0" />
            <GradientStop Color="{StaticResource AccentPressedColor}" Offset="1.0" />
        </LinearGradientBrush>

        <SolidColorBrush x:Key="GlassBrush" Color="{StaticResource GlassColor}" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <local:InvertedBooleanToVisibilityConverter x:Key="InvertedBooleanToVisibilityConverter" />

        <Style TargetType="TabControl" x:Key="MainTabControlStyle">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TabPanel Grid.Row="0" IsItemsHost="True" Background="Transparent" Margin="0,0,0,10"/>
                            <Border Grid.Row="1" BorderBrush="{StaticResource BorderColor}" BorderThickness="0" Background="Transparent" CornerRadius="8">
                                <ContentPresenter ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem" x:Key="MainTabItemStyle">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryColor}"/>
            <Setter Property="Background" Value="#19FFFFFF"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="border" CornerRadius="6" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
                                <Setter TargetName="border" Property="Background" Value="{StaticResource CardBackgroundBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource PrimaryAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
                                <Setter TargetName="border" Property="Background" Value="#2AFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- BẮT ĐẦU THAY THẾ TOÀN BỘ STYLE NÀY -->
        <Style x:Key="FormComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#1AFFFFFF"/>
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>

            <!-- 
    PHẦN THÊM VÀO ĐỂ SỬA LỖI BINDING:
    Chúng ta định nghĩa một Style cho các Item bên trong ComboBox.
    Điều này giúp Item không cần phải tìm kiếm thuộc tính từ control cha nữa.
    -->
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Padding" Value="12,10"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" CornerRadius="4" Margin="2">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource CyberHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{StaticResource CyberBackgroundBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource CyberAccentBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                Focusable="false"
                                IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="border" CornerRadius="6"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,10,0,10"
                                                      Content="{TemplateBinding Content}"/>
                                                <Path Grid.Column="1" x:Name="Arrow"
                                          Data="M 0 0 L 4 4 L 8 0 Z"
                                          Fill="{StaticResource TextSecondaryColor}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource SecondaryAccentBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource PrimaryAccentBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite"
                                  IsHitTestVisible="False"
                                  Content="{TemplateBinding SelectionBoxItem}"
                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                  Margin="{TemplateBinding Padding}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                            <Popup x:Name="Popup"
                       Placement="Bottom"
                       IsOpen="{TemplateBinding IsDropDownOpen}"
                       AllowsTransparency="True"
                       Focusable="False"
                       PopupAnimation="Slide">
                                <Grid x:Name="DropDown"
                          SnapsToDevicePixels="True"
                          MinWidth="{TemplateBinding ActualWidth}"
                          MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder"
                                Background="#FF2A2A4E"
                                BorderThickness="1"
                                CornerRadius="6"
                                BorderBrush="{StaticResource BorderColor}"/>
                                    <ScrollViewer Margin="4,6,4,6" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryAccentBrush}"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect ShadowDepth="0" BlurRadius="8" Opacity="0.5" Color="{StaticResource PrimaryAccentColor}"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- KẾT THÚC THAY THẾ -->
        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryColor}"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <TextBlock Text="{TemplateBinding Content}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#22FFFFFF"/>
                                <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WindowCloseButtonStyle" BasedOn="{StaticResource TitleBarButtonStyle}" TargetType="Button">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E81123"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AccentActionButtonStyle" TargetType="Button">
            <!-- Sử dụng Brush mới, không dùng Gradient nữa -->
            <Setter Property="Background" Value="{StaticResource ActionButtonBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <!-- Hiệu ứng đổ bóng cũng dùng màu mới cho đồng bộ -->
                                <DropShadowEffect ShadowDepth="0" BlurRadius="15" Opacity="0.4" Color="{StaticResource ActionButtonColor}"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Trigger khi di chuột qua -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource ActionButtonHoverBrush}"/>
                            </Trigger>
                            <!-- Trigger khi nhấn nút -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource ActionButtonPressedBrush}"/>
                                <Setter TargetName="border" Property="Effect" Value="{x:Null}"/>
                            </Trigger>
                            <!-- Trigger khi nút bị vô hiệu hóa -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.6"/>
                                <Setter TargetName="border" Property="Effect" Value="{x:Null}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextColor}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="15,10" />
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#19FFFFFF"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource TextColor}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FormInputStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#1AFFFFFF"/>
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextColor}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" CornerRadius="6"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource SecondaryAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource PrimaryAccentBrush}"/>
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect ShadowDepth="0" BlurRadius="8" Opacity="0.5" Color="{StaticResource PrimaryAccentColor}"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="InfoCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/>
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="25" />
            <Setter Property="Margin" Value="10" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect ShadowDepth="0" BlurRadius="20" Opacity="0.1" Color="{StaticResource ShadowColorValue}"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RoundedProgressBarStyle" TargetType="{x:Type ProgressBar}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ProgressBar}">
                        <Grid x:Name="TemplateRoot">
                            <Border x:Name="PART_Track" Background="#33FFFFFF" CornerRadius="4" />
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="4" HorizontalAlignment="Left" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="{StaticResource AccentGradientBrush}"/>
            <Setter Property="Background" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="8"/>
        </Style>
        <Style x:Key="FormLabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,15,0,5" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryColor}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#44FFFFFF" BorderThickness="1" CornerRadius="12">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="{StaticResource WindowBackgroundColorValue}" Offset="0.0" />
                <GradientStop Color="#FF1F1F3D" Offset="1.0" />
            </LinearGradientBrush>
        </Border.Background>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0" x:Name="TitleBar" MouseDown="TitleBar_MouseDown" Background="Transparent" Padding="10,5" Height="50">
                <Grid>
                    <TextBlock Text="AIO TEXT-TO-SPEECH" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="15,0,0,0" FontSize="16" FontFamily="{StaticResource CyberpunkFont}" Foreground="{StaticResource PrimaryAccentBrush}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource TitleBarButtonStyle}" Content="&#xE921;" Click="MinimizeButton_Click"/>
                        <Button Style="{StaticResource WindowCloseButtonStyle}" Content="&#xE8BB;" Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Content -->
            <!-- Main Content -->
            <Grid Grid.Row="1" Margin="20,0,20,20">

                <!-- Giao diện chính, sẽ bị vô hiệu hóa lúc đầu -->
                <Grid x:Name="MainContentGrid" IsEnabled="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="350"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Panel: Voice Selection & Filters -->
                    <Border Grid.Column="0" Style="{StaticResource InfoCardStyle}" Margin="0,0,10,0" Padding="15">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Filters -->
                            <TextBlock Grid.Row="0" Text="BỘ LỌC GIỌNG ĐỌC" Style="{StaticResource FormLabelStyle}" Margin="5,0,0,10" FontSize="14"/>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="LanguageFilterComboBox" Grid.Column="0" Margin="0,0,5,0" Style="{StaticResource FormComboBoxStyle}" SelectionChanged="FilterComboBox_SelectionChanged"/>
                                <ComboBox x:Name="GenderFilterComboBox" Grid.Column="1" Margin="5,0,0,0" Style="{StaticResource FormComboBoxStyle}" SelectionChanged="FilterComboBox_SelectionChanged"/>
                            </Grid>

                            <TextBlock Grid.Row="2" Text="CHỌN GIỌNG ĐỌC" Style="{StaticResource FormLabelStyle}" Margin="5,15,0,10" FontSize="14"/>
                            <ListView Grid.Row="3" x:Name="VoicesListView" Background="Transparent" BorderThickness="0"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          SelectionMode="Single">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListViewItem">
                                                    <Border x:Name="Bd" BorderBrush="Transparent" BorderThickness="1" Padding="10,8" Margin="0,2" CornerRadius="6" Background="Transparent">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource CyberBackgroundBrush}"/>
                                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource CyberAccentBrush}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource CyberHoverBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextColor}"/>
                                            <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryColor}">
                                    <Run Text="{Binding Locale}"/>
                                    <Run Text=" - "/>
                                    <Run Text="{Binding Gender}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>

                    <!-- Right Panel: Main Functionality with Tabs -->
                    <Grid Grid.Column="1" Margin="10,0,0,0">
                        <TabControl Style="{StaticResource MainTabControlStyle}" ItemContainerStyle="{StaticResource MainTabItemStyle}">
                            <!-- Tab 1: Single Text Conversion -->
                            <TabItem Header="Văn bản đơn" Margin="0,0,-24,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Style="{StaticResource InfoCardStyle}" Margin="0" Padding="5">
                                        <TextBox x:Name="TextInput" Style="{StaticResource FormInputStyle}" 
                                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     BorderThickness="0" Background="Transparent"
                                     Text="Nhập văn bản bạn muốn chuyển thành giọng nói tại đây."/>
                                    </Border>

                                    <Border Grid.Row="1" Style="{StaticResource InfoCardStyle}" Margin="0,15,0,0" Padding="20">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="Tốc độ đọc" Style="{StaticResource FormLabelStyle}" Margin="0"/>
                                                <TextBlock Text="{Binding Value, ElementName=SpeedSlider, StringFormat={}{0:F2}x}" HorizontalAlignment="Right" Foreground="{StaticResource TextSecondaryColor}"/>
                                            </Grid>
                                            <Slider x:Name="SpeedSlider" Minimum="0.25" Maximum="2.0" Value="1.0" TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="0,5,0,10"/>

                                            <Button x:Name="GenerateButton" Content="Tạo Giọng Nói và Nghe Thử" Style="{StaticResource AccentActionButtonStyle}" Height="44" Margin="0,20,0,0" Click="GenerateButton_Click"/>
                                            <StackPanel x:Name="PlaybackControlsPanel" Orientation="Vertical" HorizontalAlignment="Stretch" Margin="0,15,0,0" Visibility="Collapsed">
                                                <!-- Grid chứa thanh trượt và thời gian -->
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock x:Name="TimeProgressText" Grid.Column="0" Text="00:00" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{StaticResource TextSecondaryColor}"/>

                                                    <Slider x:Name="TimelineSlider" Grid.Column="1" VerticalAlignment="Center"
                Thumb.DragStarted="TimelineSlider_DragStarted"
                Thumb.DragCompleted="TimelineSlider_DragCompleted" />

                                                    <TextBlock x:Name="TimeTotalText" Grid.Column="2" Text="00:00" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{StaticResource TextSecondaryColor}"/>
                                                </Grid>

                                                <!-- Panel chứa các nút bấm -->
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <Button x:Name="PlayPauseButton" Content="▶ Play" Style="{StaticResource SecondaryButtonStyle}" Width="150" Height="40" Click="PlayPauseButton_Click"/>
                                                    <Button x:Name="DownloadButton" Content="Tải xuống" Style="{StaticResource SecondaryButtonStyle}" Width="150" Height="40" Margin="10,0,0,0" Click="DownloadButton_Click"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </TabItem>

                            <!-- Tab 2: Batch SRT Conversion -->
                            <TabItem Header="Hàng loạt từ SRT" Margin="39,0,-44,0">
                                <Border Style="{StaticResource InfoCardStyle}" Margin="0" Padding="20">
                                    <StackPanel>
                                        <TextBlock Text="1. Tải lên file phụ đề" Style="{StaticResource FormLabelStyle}" FontSize="14"/>
                                        <Button x:Name="LoadSrtButton" Content="Chọn file .SRT..." Style="{StaticResource SecondaryButtonStyle}" Click="LoadSrtButton_Click"/>
                                        <TextBlock x:Name="SrtFilePathText" Text="Chưa chọn file nào." Foreground="{StaticResource TextSecondaryColor}" Margin="0,5,0,15" FontStyle="Italic"/>

                                        <TextBlock Text="2. Đặt tên file đầu ra (Tiền tố)" Style="{StaticResource FormLabelStyle}" FontSize="14"/>
                                        <TextBox x:Name="OutputFileNamePrefix" Style="{StaticResource FormInputStyle}" Text="output"/>
                                        <TextBlock Text="Ví dụ: nếu nhập 'audio', file sẽ là audio_1.mp3, audio_2.mp3..." Foreground="{StaticResource TextSecondaryColor}" Margin="0,5,0,15" FontStyle="Italic"/>

                                        <TextBlock Text="3. Chọn thư mục lưu" Style="{StaticResource FormLabelStyle}" FontSize="14"/>
                                        <Button x:Name="SelectOutputFolderButton" Content="Chọn thư mục..." Style="{StaticResource SecondaryButtonStyle}" Click="SelectOutputFolderButton_Click"/>
                                        <TextBlock x:Name="OutputFolderPathText" Text="Chưa chọn thư mục." Foreground="{StaticResource TextSecondaryColor}" Margin="0,5,0,25" FontStyle="Italic"/>

                                        <Grid Margin="0,20,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Button x:Name="StartBatchButton" Grid.Column="0" Content="Bắt đầu xử lý hàng loạt" Style="{StaticResource AccentActionButtonStyle}" Height="48" Click="StartBatchButton_Click"/>

                                            <Button x:Name="CancelBatchButton" Grid.Column="1" Content="Hủy" Style="{StaticResource SecondaryButtonStyle}" Height="48" Width="120" Margin="10,0,0,0"
                                    Visibility="Collapsed" Click="CancelBatchButton_Click"/>
                                        </Grid>

                                        <Grid Margin="0,20,0,0">
                                            <ProgressBar x:Name="BatchProgressBar" Style="{StaticResource RoundedProgressBarStyle}" Height="12"/>
                                            <TextBlock x:Name="BatchProgressStatusText" Text="" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </Grid>

                <!-- Lớp phủ khởi động server -->
                <Grid x:Name="ServerStartOverlay" Background="#991A1A2E">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="400">
                        <TextBlock x:Name="ServerStatusText" Text="Server TTS chưa được khởi động." FontSize="16" TextAlignment="Center" Margin="0,0,0,20"/>
                        <Button x:Name="StartServerButton" Content="Khởi Động Server" Style="{StaticResource AccentActionButtonStyle}" Height="48" Width="250" Click="StartServerButton_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>