<Window x:Class="subphimv1.DownloadProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Đang xử lý" Height="190" Width="400"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        MouseDown="Window_MouseDown"
        Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="RoundedProgressBarStyle" TargetType="{x:Type ProgressBar}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ProgressBar}">
                        <Grid x:Name="TemplateRoot">
                            <Border x:Name="PART_Track" Background="{StaticResource BorderColor}" CornerRadius="4" />
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="4" HorizontalAlignment="Left" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="{StaticResource AccentColor}"/>
            <Setter Property="Background" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="10"/>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource WindowBackgroundColor}"
            BorderBrush="{StaticResource AccentColor}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,5,20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="TitleTextBlock" Grid.Row="0"
                       Text="Đang tải xuống bản cập nhật..."
                       FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource TextColor}" Margin="0,0,0,15"/>

            <StackPanel Grid.Row="1" VerticalAlignment="Center" Height="Auto">
                <!-- Sửa lại: Dùng x:Name để cả 2 chế độ đều có thể cập nhật -->
                <ProgressBar x:Name="ProgressBar" Minimum="0" Maximum="100" Height="15" 
                             Style="{StaticResource RoundedProgressBarStyle}"/>

                <!-- Sửa lại: Dùng x:Name và thêm 1 TextBlock cho phần trăm/tốc độ -->
                <Grid Margin="0,8,0,0">
                    <TextBlock x:Name="StatusTextBlock" Text="Đang khởi tạo..."
                               HorizontalAlignment="Left" Foreground="{StaticResource TextSecondaryColor}"
                               FontSize="12" />
                    <TextBlock x:Name="PercentageTextBlock" Text="0%"
                               HorizontalAlignment="Right" Foreground="{StaticResource TextSecondaryColor}"
                               FontSize="12" />
                </Grid>
            </StackPanel>

            <Button x:Name="CancelButton" Grid.Row="2"
                    Content="Hủy bỏ" Click="CancelButton_Click"
                    HorizontalAlignment="Center" MinWidth="120" Height="35"
                    Visibility="Collapsed" 
                    Margin="0,20,0,0"/>
        </Grid>
    </Border>
</Window>