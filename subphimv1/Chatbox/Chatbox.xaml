<Window x:Class="subphimv1.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:subphimv1"
        mc:Ignorable="d"
        Title="ChatBot" Height="500" Width="350"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="False" WindowStartupLocation="CenterScreen">

    <Border Background="{StaticResource PanelBackgroundColor}" BorderBrush="{StaticResource AccentColor}" BorderThickness="1" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Thanh tiêu đề để kéo thả -->
            <Border Grid.Row="0" Background="{StaticResource LighterPanelBackgroundColor}" CornerRadius="8,8,0,0" MouseDown="TitleBar_MouseDown">
                <Grid>
                    <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                    <Button Content="" FontFamily="Segoe MDL2 Assets" Style="{StaticResource WindowCloseButtonStyle}" HorizontalAlignment="Right" Click="CloseButton_Click" Height="30" Width="40"/>
                </Grid>
            </Border>

            <!-- Khu vực hiển thị tin nhắn -->
            <ScrollViewer Grid.Row="1" x:Name="MessageScrollViewer" VerticalScrollBarVisibility="Auto" Margin="5">
                <ItemsControl x:Name="MessagesItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border MaxWidth="250" Margin="5" Padding="10" CornerRadius="10"
                                    HorizontalAlignment="{Binding IsMine, Converter={StaticResource BooleanToAlignmentConverter}}">
                                <Border.Background>
                                    <SolidColorBrush Color="{Binding IsMine, Converter={StaticResource BooleanToColorConverter}}"/>
                                </Border.Background>
                                <StackPanel>
                                    <TextBlock Text="{Binding Username}" FontWeight="Bold" Foreground="#FFFFFF" Opacity="0.8"/>
                                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="#FFFFFF" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Khu vực nhập liệu -->
            <Grid Grid.Row="2" Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="MessageTextBox" VerticalAlignment="Center" KeyDown="MessageTextBox_KeyDown"/>
                <Button Grid.Column="1" Content="" FontFamily="Segoe MDL2 Assets" Width="40" Height="34" Margin="5,0,0,0" Click="SendButton_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>